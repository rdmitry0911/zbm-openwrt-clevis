#!/bin/bash
set -euo pipefail

export PATH=/usr/bin:/usr/sbin:/bin:/sbin
[ -r /run/zbm-runtime/kcl.env ] && source /run/zbm-runtime/kcl.env

log_network() {
  local msg="$1"

  printf '%s\n' "${msg}"
  printf '<6>%s\n' "[zbm-network-up] ${msg}" >/dev/kmsg 2>/dev/null || true
}

ignored_ifname() {
  case "${1}" in
    lo|br-*|ifb*|sit*|tun*|tap*|veth*|docker*|virbr*)
      return 0
      ;;
  esac

  return 1
}

iface_exists() {
  [ -e "/sys/class/net/${1}" ]
}

is_wireless_ifname() {
  local ifn

  ifn="${1}"
  [ -d "/sys/class/net/${ifn}/wireless" ] && return 0
  [ -e "/sys/class/net/${ifn}/phy80211" ] && return 0
  return 1
}

normalize_macaddr() {
  local mac

  mac="${1,,}"
  mac="${mac//-/:}"
  case "${mac}" in
    [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
      printf '%s' "${mac}"
      return 0
      ;;
  esac

  return 1
}

ifname_macaddr() {
  local ifn mac

  ifn="${1}"
  [ -r "/sys/class/net/${ifn}/address" ] || return 1
  mac="$(cat "/sys/class/net/${ifn}/address" 2>/dev/null || true)"
  normalize_macaddr "${mac}"
}

unblock_wireless_rfkill() {
  local rf type changed

  changed=0
  for rf in /sys/class/rfkill/rfkill*; do
    [ -e "${rf}" ] || continue
    type="$(cat "${rf}/type" 2>/dev/null || true)"
    case "${type}" in
      wlan|wifi) ;;
      *) continue ;;
    esac
    if (printf '1' > "${rf}/state") 2>/dev/null; then
      changed=1
    fi
  done

  [ "${changed}" = "0" ] || log_network "unblocked wireless rfkill state"
}

discover_ethernet_ifname_by_mac() {
  local want ifn mac

  want="$(normalize_macaddr "${1}" || true)"
  [ -n "${want}" ] || return 1

  for ifn in /sys/class/net/*; do
    ifn="${ifn##*/}"
    ignored_ifname "${ifn}" && continue
    is_wireless_ifname "${ifn}" && continue
    [ -e "/sys/class/net/${ifn}/device" ] || continue
    mac="$(ifname_macaddr "${ifn}" || true)"
    [ "${mac}" = "${want}" ] || continue
    printf '%s\n' "${ifn}"
    return 0
  done

  return 1
}

discover_ethernet_ifname() {
  local ifn pass carrier

  for pass in carrier any; do
    for ifn in /sys/class/net/*; do
      ifn="${ifn##*/}"
      ignored_ifname "${ifn}" && continue
      is_wireless_ifname "${ifn}" && continue
      [ -e "/sys/class/net/${ifn}/device" ] || continue
      if [ "${pass}" = "carrier" ]; then
        carrier="$(cat "/sys/class/net/${ifn}/carrier" 2>/dev/null || true)"
        [ "${carrier}" = "1" ] || continue
      fi
      printf '%s\n' "${ifn}"
      return 0
    done
  done

  return 1
}

discover_wireless_ifname() {
  local ifn

  for ifn in /sys/class/net/*; do
    ifn="${ifn##*/}"
    ignored_ifname "${ifn}" && continue
    is_wireless_ifname "${ifn}" || continue
    printf '%s\n' "${ifn}"
    return 0
  done

  return 1
}

discover_wireless_phy() {
  local phy

  for phy in /sys/class/ieee80211/*; do
    [ -e "${phy}" ] || continue
    printf '%s\n' "${phy##*/}"
    return 0
  done

  return 1
}

wireless_phy_path() {
  local phy devpath cur base idx

  phy="${1}"
  [ -n "${phy}" ] || return 1
  devpath="$(readlink -f "/sys/class/ieee80211/${phy}/device" 2>/dev/null || true)"
  [ -n "${devpath}" ] || return 1

  devpath="${devpath#/sys/devices/}"
  case "${devpath}" in
    platform/*/pci*) devpath="${devpath#platform/}" ;;
  esac

  idx=0
  for cur in /sys/class/ieee80211/"${phy}"/device/ieee80211/*; do
    [ -e "${cur}" ] || continue
    base="${cur##*/}"
    [ "${base}" = "${phy}" ] && break
    idx=$((idx + 1))
  done
  [ "${idx}" -gt 0 ] && devpath="${devpath}+${idx}"

  printf '%s' "${devpath}"
}

wireless_phy_matches_path() {
  local phy want have want_base have_base

  phy="${1}"
  want="${2}"
  [ -n "${phy}" ] && [ -n "${want}" ] || return 1

  have="$(wireless_phy_path "${phy}" || true)"
  [ -n "${have}" ] || return 1
  [ "${have}" = "${want}" ] && return 0

  want_base="${want%%+*}"
  have_base="${have%%+*}"
  [ "${have_base}" = "${want_base}" ] && return 0

  case "${have_base}" in
    *"${want_base}") return 0 ;;
  esac

  return 1
}

discover_wireless_phy_by_path() {
  local want phy

  want="${1}"
  [ -n "${want}" ] || return 1

  for phy in /sys/class/ieee80211/*; do
    [ -e "${phy}" ] || continue
    phy="${phy##*/}"
    wireless_phy_matches_path "${phy}" "${want}" || continue
    printf '%s\n' "${phy}"
    return 0
  done

  return 1
}

wireless_hardware_present() {
  [ -n "$(discover_wireless_phy || true)" ] || [ -n "$(discover_wireless_ifname || true)" ]
}

wait_wireless_hardware() {
  local tries

  tries="${1:-15}"
  while [ "${tries}" -gt 0 ]; do
    wireless_hardware_present && return 0
    sleep 1
    tries=$((tries - 1))
  done

  return 1
}

uci_get() {
  command -v uci >/dev/null 2>&1 || return 1
  uci -q get "$1"
}

uci_set() {
  command -v uci >/dev/null 2>&1 || return 0
  uci -q set "$1=$2" >/dev/null 2>&1 || true
}

uci_add_list() {
  command -v uci >/dev/null 2>&1 || return 0
  uci -q add_list "$1=$2" >/dev/null 2>&1 || true
}

uci_delete() {
  command -v uci >/dev/null 2>&1 || return 0
  uci -q delete "$1" >/dev/null 2>&1 || true
}

uci_commit() {
  command -v uci >/dev/null 2>&1 || return 0
  uci -q commit "$1" >/dev/null 2>&1 || true
}

configured_wwan_ifname() {
  local device ifn

  ifn="${ZBM_WWAN_IFNAME:-${ZBM_WIFI_IFNAME:-}}"
  if [ -z "${ifn}" ]; then
    device="${ZBM_WIFI_DEVICE:-radio0}"
    ifn="$(uci_get "wireless.default_${device}.ifname" || true)"
  fi
  [ -n "${ifn}" ] || ifn=wlan0
  printf '%s' "${ifn}"
}

resolve_wifi_phy() {
  local device phy path

  device="${ZBM_WIFI_DEVICE:-radio0}"
  phy="${ZBM_WIFI_PHY:-}"
  [ -n "${phy}" ] || phy="$(uci_get "wireless.${device}.phy" || true)"
  if [ -n "${phy}" ] && [ -d "/sys/class/ieee80211/${phy}" ]; then
    printf '%s' "${phy}"
    return 0
  fi

  path="${ZBM_WIFI_PATH:-}"
  [ -n "${path}" ] || path="$(uci_get "wireless.${device}.path" || true)"
  if [ -n "${path}" ]; then
    phy="$(discover_wireless_phy_by_path "${path}" || true)"
    if [ -n "${phy}" ]; then
      printf '%s' "${phy}"
      return 0
    fi
  fi

  discover_wireless_phy
}

wpa_quote() {
  local value

  value="${1//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '"%s"' "${value}"
}

write_manual_wpa_config() {
  local file encryption

  file="${1}"
  encryption="${ZBM_WIFI_ENCRYPTION:-psk2}"
  mkdir -p /var/run/wpa_supplicant
  {
    printf 'ctrl_interface=/var/run/wpa_supplicant\n'
    printf 'update_config=0\n'
    [ -z "${ZBM_WIFI_COUNTRY:-}" ] || printf 'country=%s\n' "${ZBM_WIFI_COUNTRY}"
    printf 'network={\n'
    printf '\tssid=%s\n' "$(wpa_quote "${ZBM_WIFI_SSID:-}")"
    printf '\tscan_ssid=1\n'
    case "${encryption}" in
      none|open)
        printf '\tkey_mgmt=NONE\n'
        ;;
      *)
        printf '\tkey_mgmt=WPA-PSK\n'
        printf '\tpsk=%s\n' "$(wpa_quote "${ZBM_WIFI_PSK:-}")"
        ;;
    esac
    printf '}\n'
  } > "${file}"
  chmod 0600 "${file}"
}

ensure_wifi_netdev() {
  local ifn phy

  [ -n "${ZBM_WIFI_SSID:-}" ] || return 0
  ifn="$(configured_wwan_ifname)"
  iface_exists "${ifn}" && return 0

  phy="$(resolve_wifi_phy || true)"
  if [ -z "${phy}" ]; then
    log_network "wifi fallback could not find a phy for ${ifn}"
    return 1
  fi

  if iw phy "${phy}" interface add "${ifn}" type managed >/dev/null 2>&1; then
    log_network "created wifi STA interface ${ifn} on ${phy}"
    ip link set "${ifn}" up 2>/dev/null || true
    uci_set network.wwan.device "${ifn}"
    uci_commit network
    return 0
  fi

  log_network "wifi fallback failed to create ${ifn} on ${phy}"
  return 1
}

start_manual_wifi_sta() {
  local ifn conf pidfile pid

  [ -n "${ZBM_WIFI_SSID:-}" ] || return 0
  ifn="$(configured_wwan_ifname)"
  iface_exists "${ifn}" || ensure_wifi_netdev || return 1
  iface_exists "${ifn}" || return 1

  ip link set "${ifn}" up 2>/dev/null || true
  uci_set network.wwan.device "${ifn}"
  uci_commit network

  [ -x /usr/sbin/wpa_supplicant ] || return 1
  conf="/tmp/zbm-wpa_supplicant-${ifn}.conf"
  pidfile="/var/run/zbm-wpa_supplicant-${ifn}.pid"
  pid="$(cat "${pidfile}" 2>/dev/null || true)"
  if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
    return 0
  fi

  write_manual_wpa_config "${conf}"
  rm -f "/var/run/wpa_supplicant/${ifn}" "${pidfile}"
  if wpa_supplicant -B -P "${pidfile}" -D nl80211 -i "${ifn}" -c "${conf}" \
      >/tmp/zbm-wpa-supplicant.log 2>&1; then
    log_network "started manual wpa_supplicant on ${ifn}"
    return 0
  fi

  log_network "manual wpa_supplicant failed on ${ifn}"
  return 1
}

start_wpad_service() {
  [ -x /etc/init.d/wpad ] || return 0
  /etc/init.d/wpad start >/dev/null 2>&1 || true
}

ip4_for_ifname() {
  local ifn

  ifn="${1}"
  [ -n "${ifn}" ] || return 1
  iface_exists "${ifn}" || return 1
  ip -o -4 addr show dev "${ifn}" scope global 2>/dev/null | awk '
    {
      split($4, a, "/")
      print a[1]
      exit
    }
  '
}

resolve_wan_ifname() {
  local ifn mac matched

  mac="${ZBM_NET_MACADDR:-${ZBM_WAN_MACADDR:-}}"
  if [ -n "${mac}" ]; then
    matched="$(discover_ethernet_ifname_by_mac "${mac}" || true)"
    if [ -n "${matched}" ]; then
      printf '%s' "${matched}"
      return 0
    fi
    return 1
  fi

  ifn="${ZBM_WAN_IFNAME:-${ZBM_NET_IFNAME:-}}"
  [ -n "${ifn}" ] || ifn="$(uci_get network.wan.device || true)"
  if [ -n "${ifn}" ] && iface_exists "${ifn}"; then
    printf '%s' "${ifn}"
    return 0
  fi

  discover_ethernet_ifname
}

resolve_wwan_ifname() {
  local ifn

  ifn="${ZBM_WWAN_IFNAME:-${ZBM_WIFI_IFNAME:-}}"
  if [ -n "${ifn}" ] && iface_exists "${ifn}"; then
    printf '%s' "${ifn}"
    return 0
  fi

  discover_wireless_ifname
}

ensure_wan_device_config() {
  local configured fallback mac matched

  configured="${ZBM_WAN_IFNAME:-${ZBM_NET_IFNAME:-}}"
  [ -n "${configured}" ] || configured="$(uci_get network.wan.device || true)"
  mac="${ZBM_NET_MACADDR:-${ZBM_WAN_MACADDR:-}}"
  if [ -n "${mac}" ]; then
    matched="$(discover_ethernet_ifname_by_mac "${mac}" || true)"
    if [ -n "${matched}" ]; then
      ZBM_NET_IFNAME="${matched}"
      ZBM_WAN_IFNAME="${matched}"
      if [ "${configured}" != "${matched}" ]; then
        log_network "configured ethernet ${configured:-none} does not match ${mac}, using ${matched}"
        uci_set network.wan.device "${matched}"
        uci_commit network
      fi
      return 0
    fi
    log_network "configured ethernet mac ${mac} was not found"
    return 0
  fi

  if [ -n "${configured}" ] && iface_exists "${configured}"; then
    return 0
  fi

  fallback="$(discover_ethernet_ifname || true)"
  [ -n "${fallback}" ] || return 0
  [ "${fallback}" = "${configured}" ] && return 0

  log_network "configured ethernet ${configured:-none} is absent, using ${fallback}"
  uci_set network.wan.device "${fallback}"
  uci_commit network
}

ensure_wireless_device_config() {
  local device phy path configured_path configured_phy

  [ -n "${ZBM_WIFI_SSID:-}" ] || return 0
  device="${ZBM_WIFI_DEVICE:-radio0}"
  path="${ZBM_WIFI_PATH:-}"
  phy="${ZBM_WIFI_PHY:-}"
  [ -n "${phy}" ] || phy="$(discover_wireless_phy || true)"
  [ -n "${path}" ] || path="$(wireless_phy_path "${phy}" || true)"

  configured_path="$(uci_get "wireless.${device}.path" || true)"
  configured_phy="$(uci_get "wireless.${device}.phy" || true)"
  if [ -n "${path}" ] && [ "${configured_path}" != "${path}" ]; then
    log_network "configured wifi ${device} path ${configured_path:-none} is absent, using ${path}"
    uci_set "wireless.${device}.path" "${path}"
    uci_commit wireless
  elif [ -z "${path}" ] && [ -n "${phy}" ] && [ "${configured_phy}" != "${phy}" ]; then
    log_network "configured wifi ${device} phy ${configured_phy:-none} is absent, using ${phy}"
    uci_set "wireless.${device}.phy" "${phy}"
    uci_commit wireless
  fi
}

bring_link_up() {
  local ifn

  ifn="${1}"
  [ -n "${ifn}" ] || return 0
  iface_exists "${ifn}" || return 0
  ip link set "${ifn}" up 2>/dev/null || true
}

network_has_default_route() {
  ip route show default 2>/dev/null | grep -q '^default '
}

default_gateway_for_ifname() {
  local ifn

  ifn="${1}"
  [ -n "${ifn}" ] || return 1
  ip -4 route show default dev "${ifn}" 2>/dev/null | awk '
    /^default / {
      for (i = 1; i <= NF; i++) {
        if ($i == "via" && (i + 1) <= NF) {
          print $(i + 1)
          exit
        }
      }
    }
  '
}

uplink_status() {
  local wan_if wwan_if wan_ip wwan_ip

  wan_if="$(resolve_wan_ifname || true)"
  wwan_if="$(resolve_wwan_ifname || true)"
  wan_ip="$(ip4_for_ifname "${wan_if}" || true)"
  wwan_ip="$(ip4_for_ifname "${wwan_if}" || true)"

  printf 'wan(%s)=%s wwan(%s)=%s' \
    "${wan_if:-absent}" "${wan_ip:-down}" \
    "${wwan_if:-absent}" "${wwan_ip:-down}"
}

network_ready() {
  local wan_if wwan_if

  wan_if="$(resolve_wan_ifname || true)"
  wwan_if="$(resolve_wwan_ifname || true)"

  { [ -n "$(ip4_for_ifname "${wan_if}" || true)" ] ||
    [ -n "$(ip4_for_ifname "${wwan_if}" || true)" ]; } || return 1
  network_has_default_route || return 1
  return 0
}

wait_network_ready() {
  local tries

  tries="${1:-30}"
  while [ "${tries}" -gt 0 ]; do
    if network_ready; then
      return 0
    fi
    sleep 1
    tries=$((tries - 1))
  done

  return 1
}

wwan_ready() {
  local wwan_if

  wwan_if="$(resolve_wwan_ifname || true)"
  [ -n "$(ip4_for_ifname "${wwan_if}" || true)" ]
}

wait_wwan_ready() {
  local tries

  tries="${1:-20}"
  while [ "${tries}" -gt 0 ]; do
    if wwan_ready; then
      return 0
    fi
    sleep 1
    tries=$((tries - 1))
  done

  return 1
}

refresh_mwan3_interface_tracking() {
  local section ifn gw

  section="${1}"
  ifn="${2}"
  [ -n "${section}" ] || return 0

  uci_delete "mwan3.${section}.track_ip"
  gw="$(default_gateway_for_ifname "${ifn}" || true)"
  [ -n "${gw}" ] && uci_add_list "mwan3.${section}.track_ip" "${gw}"
  uci_add_list "mwan3.${section}.track_ip" "1.1.1.1"
  uci_add_list "mwan3.${section}.track_ip" "8.8.8.8"
}

refresh_mwan3_tracking() {
  local wan_if wwan_if

  wan_if="$(resolve_wan_ifname || true)"
  wwan_if="$(resolve_wwan_ifname || true)"

  refresh_mwan3_interface_tracking wan "${wan_if}"
  refresh_mwan3_interface_tracking wwan "${wwan_if}"
  uci_commit mwan3
}

ensure_wan_device_config
unblock_wireless_rfkill
if [ -n "${ZBM_WIFI_SSID:-}" ]; then
  wait_wireless_hardware 15 || log_network "wifi hardware did not appear before network setup"
  start_wpad_service
fi
ensure_wireless_device_config
bring_link_up "$(resolve_wan_ifname || true)"

if [ -x /etc/init.d/network ]; then
  /etc/init.d/network reload >/dev/null 2>&1 ||
    /etc/init.d/network restart >/dev/null 2>&1 ||
    /etc/init.d/network start >/dev/null 2>&1 || true
fi

ifup wan >/dev/null 2>&1 || true

if [ -n "${ZBM_WIFI_SSID:-}" ]; then
  if command -v wifi >/dev/null 2>&1; then
    wifi up >/dev/null 2>&1 || true
  fi
  ifup wwan >/dev/null 2>&1 || true
  if [ -z "$(resolve_wwan_ifname || true)" ]; then
    start_manual_wifi_sta || true
    ifup wwan >/dev/null 2>&1 || true
  fi
fi

if [ -x /etc/init.d/mwan3 ]; then
  /etc/init.d/mwan3 enable >/dev/null 2>&1 || true
fi

if wait_network_ready 30; then
  if [ -n "${ZBM_WIFI_SSID:-}" ] && wireless_hardware_present; then
    if ! wait_wwan_ready 25; then
      start_manual_wifi_sta || true
      ifup wwan >/dev/null 2>&1 || true
      wait_wwan_ready 10 || true
    fi
  fi
  if [ -x /etc/init.d/firewall ]; then
    /etc/init.d/firewall reload >/dev/null 2>&1 ||
      /etc/init.d/firewall restart >/dev/null 2>&1 ||
      /etc/init.d/firewall start >/dev/null 2>&1 || true
  fi
  if [ -x /etc/init.d/mwan3 ]; then
    refresh_mwan3_tracking
    /etc/init.d/mwan3 restart >/dev/null 2>&1 || true
  fi
  log_network "network ready: $(uplink_status)"
  exit 0
fi

log_network "network did not become ready: $(uplink_status)"
exit 1
